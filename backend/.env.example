APP_NAME=Network Config Manager
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DEVICE_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
DATABASE_URL=sqlite:///./ncm.db
BACKUP_ROOT=./backups
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# --- Identity provider (optional) -------------------------------------------
# API token acceptance needs the first two. Browser sign-in needs the client id,
# secret and redirect URL as well; the redirect URL must match what the provider
# has registered, exactly.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Only when this service reaches the provider on a different origin than the
# browser does, as in a container deployment. Tokens are still validated against
# the public issuer above.
OIDC_INTERNAL_BASE_URL=
# Role given to a user provisioned on first sight. Least privilege on purpose.
OIDC_DEFAULT_ROLE=viewer
# Set false only for plain HTTP in local development.
OIDC_COOKIE_SECURE=true
